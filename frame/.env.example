# --- Immich (required) ---
IMMICH_BASE_URL=https://immich.example.com
IMMICH_API_KEY=your_api_key_here
ALBUM_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Display (optional; can also be changed from Home Assistant) ---
ORIENTATION=landscape        # landscape | portrait
INTERVAL_MINUTES=15          # 3-1440; e-ink panels should not be redrawn constantly

# --- Home Assistant API (optional) ---
API_PORT=8765
# FRAME_API_TOKEN=            # leave empty: a token is generated; show it with `python -m frame token`
# DEVICE_NAME=Inky Frame      # name of the device in Home Assistant

# --- Dimmable LED (optional) ---
# LED_GPIO=18                 # BCM number; see docs/led.md

# --- Development ---
# MOCK_DISPLAY=1              # no hardware: writes data/mock_display.png
