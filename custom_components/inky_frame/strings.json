{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Connect Inky Frame",
        "description": "Enter the address of your Raspberry Pi. Show the API token on the Pi with `python -m frame token`.",
        "data": { "host": "Host", "port": "Port", "token": "API token" }
      },
      "zeroconf_confirm": {
        "title": "Inky Frame found",
        "description": "Found **{name}** at {host}. Enter its API token (`python -m frame token` on the Pi).",
        "data": { "token": "API token" }
      },
      "reauth_confirm": {
        "title": "Re-authenticate Inky Frame",
        "description": "The API token was rejected. Enter the current token.",
        "data": { "token": "API token" }
      }
    },
    "error": {
      "cannot_connect": "Cannot reach the frame. Is the service running?",
      "invalid_auth": "The API token is wrong.",
      "not_inky_frame": "This is not an Inky Frame."
    },
    "abort": {
      "already_configured": "This frame is already configured.",
      "not_inky_frame": "This is not an Inky Frame.",
      "reauth_successful": "Re-authentication successful."
    }
  },
  "entity": {
    "button": {
      "next_photo": { "name": "Next photo" },
